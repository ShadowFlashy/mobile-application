{
  "name": "redline",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "build:web": "expo export -p web --clear && node scripts/postbuild-web.mjs",
    "serve:web": "serve dist --listen 8081 --config ../serve.json --no-clipboard",
    "deploy:web": "npm run build:web && npx vercel deploy dist --prod --yes --project redline --create-if-missing",
    "build:android:preview": "eas build -p android --profile preview",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress",
    "test:unit": "cypress run --component",
    "test:e2e": "start-server-and-test serve:web http://localhost:8081 cypress:run",
    "test": "npm run test:unit && npm run build:web && npm run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "*": [
      "node scripts/check-secrets.mjs"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "expo": "~52.0.46",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-font": "~13.0.4",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-localization": "~16.0.1",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "i18next": "^27.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^18.0.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "~18.3.12",
    "cypress": "^13.17.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "serve": "^14.2.7",
    "start-server-and-test": "^2.1.5",
    "storybook": "^10.5.10",
    "typescript": "^5.3.3",
    "vite": "^5.4.11"
  }
}
