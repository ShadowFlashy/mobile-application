# Copy this file to `.env` and fill in the values of your Supabase project
# (Supabase dashboard → Project Settings → API Keys). `.env` is gitignored: never commit real keys.
#
# The publishable / anon key is a public client key: all data is protected by row level security.
# Never put the secret / service_role key in this file or anywhere in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
