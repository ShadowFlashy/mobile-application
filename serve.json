{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/details/:id",
      "destination": "/details/[id].html"
    },
    {
      "source": "/sticker/:id",
      "destination": "/sticker/[id].html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
